  "narrative": {
    "northStar": "Inspectable market history",
    "overview": "A statistical atlas translated into a working research app: cobalt navigation frames a cool, near-white workspace, while white work areas keep charts, exact-symbol tables, and source actions readable. The atmosphere is calm, compact, and factual.\n\nHierarchy comes from typography, aligned measurements, thin separators, and restrained tonal changes. Teal and brick carry transfer direction; amber carries analysis warnings. Persian symbol labels and Solar Hijri dates remain intact within the current English interface. The language choice is provisional, not a permanent visual identity commitment.",
    "keyCharacteristics": [
      "Compact research typography with tabular measurements.",
      "Cobalt navigation and cool paper work areas.",
      "Semantic transfer colors with signed values and explicit labels.",
      "Flat bordered containers and visible keyboard focus."
    ],
    "rules": [
      {
        "name": "The Transfer Color Rule",
        "body": "Teal and brick describe the direction of ownership transfers; signed values and labels accompany them.",
        "section": "colors"
      },
      {
        "name": "The Flat Work Area Rule",
        "body": "Panels and filters use outlines and tonal contrast instead of ambient shadows.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do keep date range, instrument scope, and units close to measurements.",
      "Do use tabular numerals and right alignment for numeric table columns.",
      "Do preserve Persian labels and exact symbol suffixes with appropriate text direction.",
      "Do keep source downloads and analysis-status labels visible.",
      "Do let tables scroll horizontally while the surrounding workspace fits the viewport."
    ],
    "donts": [
      "Don't reuse teal and brick as arbitrary decorative accents.",
      "Don't replace aligned table values with decorative cards.",
      "Don't rely on color alone to communicate transfer direction or analysis status.",
      "Don't introduce ambient shadows on ordinary panels."
    ]
  }
}
