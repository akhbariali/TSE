[Unit]
Description=Collect actual daily TSETMC retail values for TSE and IFB
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=tse
Group=tse
WorkingDirectory=/opt/tse
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=PYTHONUNBUFFERED=1
ExecStart=/usr/bin/python3 /opt/tse/scripts/tsetmc_daily.py
ExecStartPost=/usr/bin/python3 /opt/tse/scripts/refresh_recommendations.py
TimeoutStartSec=2h
UMask=0027
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/opt/tse/data
