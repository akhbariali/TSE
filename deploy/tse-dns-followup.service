[Unit]
Description=One-time TSE DNS and HTTPS follow-up
After=network-online.target nginx.service tse.service
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/local/bin/tse-dns-followup
TimeoutStartSec=420
StandardOutput=append:/var/log/tse-dns-followup.log
StandardError=append:/var/log/tse-dns-followup.log
