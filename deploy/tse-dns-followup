#!/bin/sh
# One-time DNS/HTTPS follow-up; output is captured by systemd.
set -u
printf 'Follow-up started: '; date -u
if curl -fsS --connect-timeout 10 --max-time 20 https://tse.talebidir.shop/healthz >/dev/null 2>&1; then
    echo 'RESOLVED: trusted HTTPS is working.'
    exit 0
fi
echo 'HTTPS not yet healthy; retrying configured certificate setup.'
/usr/local/bin/tse-enable-https || true
echo 'Public DNS:'
dig @1.1.1.1 tse.talebidir.shop A +time=4 +tries=1
dig @8.8.8.8 tse.talebidir.shop A +time=4 +tries=1
echo 'Registry delegation:'
dig @a.gmoregistry.net talebidir.shop NS +norecurse +time=4 +tries=1
echo 'Assigned authoritative servers:'
dig @rain.parspack.net tse.talebidir.shop A +norecurse +time=4 +tries=1
dig @savanna.parspack.net tse.talebidir.shop A +norecurse +time=4 +tries=1
if curl -fsS --connect-timeout 10 --max-time 20 https://tse.talebidir.shop/healthz >/dev/null 2>&1; then
    echo 'RESOLVED: trusted HTTPS is working after retry.'
else
    echo 'UNRESOLVED: inspect the DNS results above; registrar/ParsPack follow-up is required.'
fi
